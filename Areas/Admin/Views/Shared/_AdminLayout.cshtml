<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Admin</title>
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css">
    <style>
        /* Sidebar ko full height dene ke liye */
        body, html {
            height: 100%;
        }

        .main-wrapper {
            display: flex;
            min-height: 100vh;
            overflow:hidden;
        }
        .admin-sidebar{
            width:280px;
            height:100vh;
            background-color: #343a40;
            flex-shrink:0;
            overflow-y:auto;
         }

        .content-area {
            flex-grow: 1;
            height:100vh;
            background-color: #f8f9fa;
            padding: 20px;
            overflow-y: auto;
        }
    </style>
</head>
<body>

    <div class="main-wrapper">
        <div class="admin-sidebar d-flex flex-column flex-shrink-0 p-3 bg-dark text-white" style="width: 280px;">
            <a href="/Admin/Dashboard/Index" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                <i class="bi bi-book-half me-2" style="font-size: 2rem;"></i>
                <span class="fs-4">BookShop Admin</span>
            </a>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="/Admin/Dashboard/Index" class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a href="/Admin/Genre/Index" class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Genre" ? "active":"")">
                        <i class="bi bi-tags me-2"></i> Genres
                    </a>
                </li>
                <li>
                    <a href="/Admin/Book/Index" class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Book" ? "active" : "")">
                        
                        <i class="bi bi-book me-2"></i> Books
                    </a>
                </li>
                <li>
                    <a href="/Admin/Order/Index" class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">
                        
                        <i class="bi bi-cart-check me-2"></i> Orders
                    </a>
                </li>
                <li>
                    <a href="/Admin/User/Index" class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
                        
                        <i class="bi bi-people me-2"></i> User Management
                    </a>
                </li>
            </ul>
            <hr>
        </div>

        <main class="content-area bg-light">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
    
</html>