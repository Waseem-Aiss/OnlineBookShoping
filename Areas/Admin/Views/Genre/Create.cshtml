@model OnlineBookShoping.Models.Genre;

<form method="post" asp-area="Admin" asp-controller="Genre" asp-action="Create">
    <div class="form-group">
        <div class="row pb-2 mb-5">
            <h2 class="text-primary">Create Genre</h2>
            <hr />
        </div>
        <label>Write New Created Genre Name Here</label>
        <input asp-for="GenreName" class="form-control"/>
        <span asp-validation-for="GenreName" class="text-danger"></span>
       
    </div>
   <div>
    <button type="submit" class="btn btn-primary">Create</button>
        <a asp-controller="Genre" asp-action="Index" class="btn btn-secondary" style="width:150px">
        Back to List
    </a>
    </div>
</form>
