@model IEnumerable<OnlineBookShoping.Models.Genre>

@{
    ViewData["Title"] = "Index";
}
<partial name="_LoginPartial" />
<h1>Index</h1>

<p>
    <a asp-area="Admin" asp-controller="Genre" asp-action="Create">Create New Genre</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.GenreName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.GenreName)
            </td>
            <td>
                <a asp-area = "Admin" asp-controller = "Genre" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-area="Admin" asp-controller="Genre" asp-action="Detail" asp-route-id="@item.Id">Details</a> |
                    <a asp-area="Admin" asp-controller="Genre" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
