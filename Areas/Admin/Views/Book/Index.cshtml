@model BookDisplayModel


@{
    ViewData["Title"] = "Books";
}
<style>
    .content-area {
        display: flex;
        flex-direction: column; /* Vertical alignment */
        height: 100vh;
        overflow: hidden; /* Poora area scroll nahi hoga */
    }

    .sticky-form-header {
        background-color: white;
        padding: 8px 15px;
        border-bottom: 1px solid #eee;
        z-index: 1000; /* Taake books iske upar na aayein */
        flex-shrink: 0;
    }

    .tight-form {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .tight-form .form-select,
        .tight-form .form-control {
            height: 35px;
            padding: 2px 10px;
        }

    .scrollable-books-container {
        flex-grow: 1; /* Baaqi bachi hui jagah ye le lega */
        overflow-y: auto; /* Sirf books wala hissa scroll hoga */
        padding: 20px;
    }
</style>

<div class="content-area">
    <div class="sticky-form-header">
        <form asp-action="Index" class="tight-form">
            <div style="width: 200px;">
                <select class="form-select" id="genreId" name="genreId">
                    <option selected>Choose...</option>
                    @foreach (var item in Model.Genres)
                    {
                        <option value="@item.Id" selected="@(item.Id == Model.genreId)">@item.GenreName</option>
                    }
                </select>
            </div>

            <div style="width: 300px;">
                <input type="text" class="form-control" id="sTerm" name="sTerm" value="@Model.sTerm" placeholder="Search by Title">
            </div>

            <button type="submit" class="btn btn-primary btn-sm">Search</button>
        </form>
    </div>

    <div class="scrollable-books-container">
        @foreach (var book in Model.Books)
        {
            <div class="card mb-2 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center p-2">
                    <div>
                        <h6 class="mb-0"><strong>@book.BookName</strong></h6>
                        <small class="text-muted">Author: @book.AuthorName | Genre: @book.GenreName | Price: @book.Price</small>
                    </div>

                    <div class="text-end">
                        <a asp-area="Admin" asp-controller="Book" asp-action="Edit" asp-route-id="@book.id">Edit</a> |
                        <a asp-area="Admin" asp-controller="Book" asp-action="Detail" asp-route-id="@book.id">Detail</a> |
                        <a asp-area="Admin" asp-controller="Book" asp-action="Delete" asp-route-id="@book.id">Delete</a>

                    </div>

                </div>

            </div>
        }

    </div>


    <nav class="mt-4">
        <ul class="pagination justify-content-end">
            @for (int i = 1; i <= Model.totalPages; i++)
            {
                <li class="page-item @(i == Model.currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i"
                       asp-route-sTerm="@Model.sTerm" asp-route-genreId="@Model.genreId">@i</a>
                </li>
            }
        </ul>
    </nav>

</div>
